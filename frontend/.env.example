# URL of the deployed backend, no trailing slash (e.g. Render web service).
# Only needed in production — leave unset for local dev, where the Vite
# proxy in vite.config.js forwards /api and /assets to localhost:5000.
#
# Vite only reads VITE_-prefixed vars, and only at BUILD time (npm run
# build), so this must be set in your hosting provider's build environment,
# not just in a local .env file you forget to redeploy from.
VITE_API_URL=https://your-backend.onrender.com
